 "pumps": [
  {
   "abbr": "SCP",
   "name": "Solubility Carbon Pump",
   "role": "Cold water dissolves more CO2 than warm water, so cooling surface water and strong winds pull CO2 from the air into the sea. This is the physical entry point for the sink: it sets the air-sea CO2 gradient the other pumps work with.",
   "source": "Global ONCE Science Plan; Takahashi et al. 1993"
  },
  {
   "abbr": "BCP",
   "name": "Biological Carbon Pump",
   "role": "Photosynthesis fixes CO2 into organic carbon; a fraction sinks as particles (POC) below the surface, where it is eaten, respired or buried. Plankton, zooplankton and fish repackage it on the way down.",
   "source": "Global ONCE Science Plan"
  },
  {
   "abbr": "MCP",
   "name": "Microbial Carbon Pump",
   "role": "Microbes transform dissolved organic carbon (DOC) that would otherwise be eaten within days into recalcitrant dissolved organic carbon (RDOC), which resists breakdown for centuries to millennia. It is the ocean's long-term dissolved store.",
   "source": "Global ONCE Science Plan; Jiao et al. 2010, Nat. Rev. Microbiol."
  },
  {
   "abbr": "CCP",
   "name": "Carbonate Counter Pump",
   "role": "Calcifiers (coccolithophores, corals, shellfish) build calcium carbonate shells. Each mole of CaCO3 precipitated releases about 0.6 mol of CO2 (Psi ~ 0.6), so calcification partly offsets the biological pump -- and the ratio rises as seawater loses buffer capacity.",
   "source": "Global ONCE Science Plan; Frankignoulle et al. 1994"
  },
  {
   "abbr": "BCMS",
   "name": "Synergistic Coupling of Four Pumps",
   "role": "The pumps do not act alone. Biological drawdown lowers surface pCO2 and primes the solubility pump; the microbial pump locks the biological pump's DOC into RDOC; the carbonate counter-pump offsets the biological pump. Warming weakens the solubility pump while the biological and microbial responses remain uncertain.",
   "source": "Global ONCE Science Plan"
  }
 ],
